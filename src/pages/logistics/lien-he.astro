---
import LogisticsLayout from '../../layouts/LogisticsLayout.astro';
import Pending from '../../components/logistics/Pending.astro';
import { pageByKey, telHref, prettyPhone } from '../../lib/logistics';
import { provider, serviceArea } from '../../data/vi/logistics';
import { getContent } from '../../data';

const page = pageByKey('lien-he');
const { contact } = getContent('vi');
---
<LogisticsLayout page={page}>
  <section class="section" aria-labelledby="ct-title">
    <div class="container split">
      <div>
        <span class="kicker">Liên hệ</span>
        <h2 id="ct-title">Kênh liên hệ dịch vụ logistics</h2>
        <p class="muted">Cách nhanh nhất: gọi hoặc nhắn Zalo kèm thông tin hàng hóa, kho gửi và nơi nhận.</p>
      </div>
      <dl class="info-table">
        <div><dt>Hotline</dt><dd><a class="text-link" href={telHref(provider.hotline)} data-track="call_click" data-track-location="contact_page">{prettyPhone(provider.hotline)}</a></dd></div>
        <div><dt>Zalo</dt><dd><a class="text-link" href={provider.zaloUrl} rel="noopener" target="_blank" data-track="zalo_click" data-track-location="contact_page">{prettyPhone(provider.hotline)}<span class="visually-hidden"> (mở tab mới)</span></a></dd></div>
        <div><dt>Email</dt><dd><a class="text-link" href={`mailto:${contact.email}`} data-track="email_click" data-track-location="contact_page">{contact.email}</a></dd></div>
        <div><dt>Điểm giao dịch tại Bắc Ninh</dt><dd><Pending fact={provider.officeAddress} /></dd></div>
      </dl>
    </div>
  </section>
  <section class="section section-alt" aria-labelledby="area-title">
    <div class="container split">
      <div>
        <h2 id="area-title">Khu vực phục vụ</h2>
        <p class="muted">VIP GROUP có điểm giao dịch tại Bắc Ninh. Khu vực khác vui lòng liên hệ để xác nhận phương án nhận hàng.</p>
      </div>
      <dl class="info-table">
        <div><dt>Khu vực tập trung</dt><dd>{serviceArea.focus.join(', ')}</dd></div>
        <div><dt>Khu vực khác</dt><dd><Pending fact={serviceArea.expansion} fallback="Liên hệ để xác nhận theo từng địa điểm" /></dd></div>
        <div><dt>Báo giá</dt><dd><a class="text-link" href="/logistics/bang-gia/#form-lien-he">Gửi yêu cầu báo giá →</a></dd></div>
      </dl>
    </div>
  </section>
</LogisticsLayout>
