---
import LogisticsLayout from '../../layouts/LogisticsLayout.astro';
import FaqList from '../../components/logistics/FaqList.astro';
import { pageByKey, linkable, warehouseHref } from '../../lib/logistics';
import { serviceLd } from '../../lib/schema';
import { services, processSteps, faqs, warehouses, provider } from '../../data/vi/logistics';

const page = pageByKey('home');
const site = Astro.site!;
const ld = [serviceLd({
  name: 'Vận chuyển hàng Trung Quốc về Việt Nam',
  serviceType: 'Vận chuyển hàng hóa quốc tế Trung Quốc – Việt Nam',
  description: page.description,
  url: new URL(page.href, site),
  areaServed: ['Bắc Ninh', 'Việt Nam'],
})];
// Thẻ kho chỉ hiện khi trang kho được xuất bản (owner xác nhận kho có thật) — verifier P0-1.
const khoLinks = warehouses.map((w) => ({ ...w, href: warehouseHref(w.id) })).filter((w) => linkable(w.href));
const audiences = [
  { title: 'Xưởng sản xuất, làng nghề', text: 'Nhập phụ kiện, vật tư, máy móc từ Trung Quốc theo lô, cần kiểm đếm và chứng từ rõ ràng.' },
  { title: 'Doanh nghiệp khu công nghiệp', text: 'Cần nhập khẩu chính ngạch, khai báo hải quan và bộ chứng từ phù hợp cho kế toán.' },
  { title: 'Chủ shop, kinh doanh online', text: 'Đặt hàng 1688 / Taobao / Pinduoduo, quản lý đơn bằng mã khách hàng riêng và theo dõi trực tuyến.' },
];
---
<LogisticsLayout page={page} jsonLd={ld}>
  <section class="section" aria-labelledby="svc-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Dịch vụ</span>
          <h2 id="svc-title">Một đầu mối cho hành trình nhập hàng Trung Quốc</h2>
        </div>
        <p>Từ đặt hàng, nhận hàng tại Trung Quốc, vận chuyển về Việt Nam đến nhập khẩu và khai báo hải quan.</p>
      </div>
      <div class="grid grid-4">
        {services.map((s, i) => (
          <article class="card">
            <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
      <p><a class="text-link" href="/logistics/van-chuyen-trung-quoc-viet-nam/">Vận chuyển hàng Trung Quốc về Việt Nam →</a></p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="kho-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Hành trình hàng</span>
          <h2 id="kho-title">{khoLinks.length ? `Nhận hàng tại ${khoLinks.map((w) => w.city).join(', ')}` : 'Từ nhà cung cấp Trung Quốc tới tay bạn'}</h2>
        </div>
        <p>Hàng được nhận tại Trung Quốc, vận chuyển về Việt Nam; khách nhận tại kho hoặc theo phương án giao hàng đã thỏa thuận.</p>
      </div>
      <div class="grid grid-3">
        {khoLinks.length === 0 && (
          <a class="card card-link" href="/logistics/quy-trinh-gui-hang/">
            <span class="card-index">TRUNG QUỐC</span>
            <h3>Nhận hàng tại Trung Quốc</h3>
            <p>Đăng ký mã khách hàng, nhận hướng dẫn địa chỉ gửi hàng tại Trung Quốc qua hotline / Zalo.</p>
            <p class="more">Xem quy trình →</p>
          </a>
        )}
        {khoLinks.length === 0 && (
          <a class="card card-link" href="/logistics/van-chuyen-trung-quoc-viet-nam/">
            <span class="card-index">VIỆT NAM</span>
            <h3>Vận chuyển và thủ tục</h3>
            <p>Vận chuyển về Việt Nam, hỗ trợ nhập khẩu chính ngạch và khai báo hải quan khi cần.</p>
            <p class="more">Xem dịch vụ →</p>
          </a>
        )}
        {khoLinks.map((w) => (
          <a class="card card-link" href={w.href}>
            <span class="card-index">{w.cityZh}</span>
            <h3>Nhận hàng tại {w.city}</h3>
            <p>Nhà cung cấp giao hàng tới điểm nhận tại {w.city}; hàng được vận chuyển về Việt Nam.</p>
            <p class="more">Xem tuyến {w.city} → Việt Nam →</p>
          </a>
        ))}
        <a class="card card-link" href="/logistics/van-chuyen-trung-quoc-bac-ninh/">
          <span class="card-index">BẮC NINH</span>
          <h3>Khách hàng Bắc Ninh</h3>
          <p>Văn phòng {provider.name} tại Đồng Nguyên, Bắc Ninh — thuận tiện cho khách hàng khu vực Từ Sơn, Đồng Kỵ liên hệ trực tiếp.</p>
          <p class="more">Vận chuyển về Bắc Ninh →</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="aud-title">
    <div class="container">
      <span class="kicker">Khách hàng</span>
      <h2 id="aud-title">Phù hợp với ai?</h2>
      <div class="grid grid-3">
        {audiences.map((a) => <article class="card"><h3>{a.title}</h3><p>{a.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="proc-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Quy trình</span>
          <h2 id="proc-title">Bốn bước bắt đầu gửi hàng</h2>
        </div>
        <a class="text-link" href="/logistics/quy-trinh-gui-hang/">Xem quy trình chi tiết →</a>
      </div>
      <ol class="steps">{processSteps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol>
      <div class="hub-links">
        <a class="btn btn-ghost" href={provider.registerUrl} rel="noopener" target="_blank" data-track="register_click" data-track-location="hub_process">Đăng ký mã khách hàng<span class="visually-hidden"> (mở tab mới)</span></a>
        <a class="btn btn-ghost" href="/logistics/tra-cuu-van-don/">Tra cứu vận đơn</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container split">
      <div>
        <span class="kicker">Hỏi đáp</span>
        <h2 id="faq-title">Câu hỏi thường gặp</h2>
        <a class="text-link" href="/logistics/cau-hoi-thuong-gap/">Xem tất cả câu hỏi →</a>
      </div>
      <FaqList items={faqs.filter((f) => !f.pending).slice(0, 4)} />
    </div>
  </section>
</LogisticsLayout>
<style>
  .hub-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
</style>
