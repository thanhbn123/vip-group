---
import LogisticsLayout from '../../../layouts/LogisticsLayout.astro';
import { knowledgeIndex, articles, pages } from '../../../data/vi/logistics';
import { isBuilt, linkable } from '../../../lib/logistics';
import { providerLd } from '../../../lib/schema';
import type { Article, LogisticsPage } from '../../../data/types';

// Bài `draft` chỉ được build ở chế độ DEMO — production không sinh trang.
export function getStaticPaths() {
  return articles.filter((a) => isBuilt(a.status)).map((a) => ({ params: { slug: a.slug }, props: { article: a } }));
}
const { article } = Astro.props as { article: Article };
const site = Astro.site!;
const href = `/logistics/kien-thuc/${article.slug}/`;
const page: LogisticsPage = {
  key: article.slug,
  href,
  nav: article.title,
  title: article.title.length > 56 ? `${article.title.slice(0, 53).trimEnd()}…` : article.title,
  description: article.description,
  h1: article.title,
  lead: article.description,
  status: article.status,
  keyword: article.keyword,
};
const crumbs = isBuilt(knowledgeIndex.status) ? [{ name: knowledgeIndex.nav, href: knowledgeIndex.href }] : [];
const orgId = new URL('/#organization', site).href;
const articleLd = {
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  dateModified: article.updated,
  inLanguage: 'vi',
  mainEntityOfPage: new URL(href, site).href,
  author: { '@id': orgId },
  publisher: { '@id': orgId },
  about: providerLd(),
};
const related = article.related.filter(linkable).map((h) => ({ href: h, label: pages.find((p) => p.href === h)?.h1 ?? h }));
---
<LogisticsLayout page={page} extraCrumbs={crumbs} jsonLd={[articleLd]} showActions={false}>
  <article class="section">
    <div class="container prose art">
      {article.sections.map((s) => (
        <section>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          {s.list && <ul>{s.list.map((x) => <li>{x}</li>)}</ul>}
        </section>
      ))}
      {related.length > 0 && (
        <aside class="related" aria-labelledby="rel-title">
          <h2 id="rel-title">Xem thêm</h2>
          <ul>{related.map((r) => <li><a class="text-link" href={r.href}>{r.label}</a></li>)}</ul>
        </aside>
      )}
    </div>
  </article>
</LogisticsLayout>
<style>
  .art h2 { font-size: 26px; margin-top: 36px; }
  .art ul { padding-left: 20px; }
  .related { margin-top: 48px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-alt); }
  .related h2 { margin-top: 0; font-size: 20px; }
</style>
