---
/**
 * Trang tuyến Thâm Quyến → Việt Nam (VIPG-WEB-024) — tối ưu SEO + GEO cho cụm
 * "vận chuyển trung việt từ thâm quyến về việt nam".
 *
 * Cấu trúc cho AI trích dẫn: đoạn trả lời trực tiếp ngay dưới H1 (< 100 từ), bảng số liệu,
 * ngày cập nhật, FAQ ngắn gọn. MỌI con số (thời gian, giá) đi qua Fact → chưa xác minh thì
 * production không hiện (và trang đang `draft`, chỉ build ở DEMO).
 */
import LogisticsLayout from '../../../layouts/LogisticsLayout.astro';
import FaqList from '../../../components/logistics/FaqList.astro';
import Pending from '../../../components/logistics/Pending.astro';
import { pageByKey, shown, linkable, telHref, prettyPhone, isBuilt } from '../../../lib/logistics';
import { serviceLd } from '../../../lib/schema';
import { shenzhenRoute as R, provider, processSteps, volumetricDivisor } from '../../../data/vi/logistics';
import type { FaqItem } from '../../../data/types';

// Route có kiểm trạng thái: trang `draft` KHÔNG được sinh ở production (file .astro tĩnh thì luôn được build).
export function getStaticPaths() {
  return isBuilt(pageByKey('tham-quyen').status) ? [{ params: { index: undefined } }] : [];
}

const page = pageByKey('tham-quyen');
const site = Astro.site!;
const url = new URL(page.href, site);

const served = shown(R.served);
const gate = shown(R.borderGate);
const tr = Object.fromEntries(R.destinations.map((d) => [d.city, shown(d.transit)]));
const anySample = [served, gate, ...Object.values(tr)].some((x) => x.isSample);
// Production chỉ hiện hình thức đã xác nhận; DEMO hiện tất cả (nhãn MẪU).
const modes = R.modes.filter((m) => shown(m.offered).value !== null);
const divisor = shown(volumetricDivisor);
const updatedVi = R.updated.split('-').reverse().join('/');
const pretty = prettyPhone(provider.hotline);

// ── Đoạn trả lời trực tiếp (answer-first) — ghép từ dữ kiện, câu nào chưa có số thì nói rõ "báo theo lô".
const hn = tr['Hà Nội'].value;
const hcm = tr['TP.HCM'].value;
const timeSentence = hn && hcm
  ? `Thời gian tham khảo: Thâm Quyến – Hà Nội ${hn}, Thâm Quyến – TP.HCM ${hcm}, tính từ khi hàng nhập kho Trung Quốc.`
  : `Thời gian và cước được ${provider.name} báo theo từng lô hàng, tùy loại hàng, hình thức vận chuyển và thủ tục hải quan.`;
const answer =
  `Hàng từ Thâm Quyến (深圳, Shenzhen – Quảng Đông) về Việt Nam phổ biến nhất là đi đường bộ qua cửa khẩu biên giới phía Bắc${gate.value ? ` (${gate.value})` : ''}, ` +
  `sau đó giao về Hà Nội, Bắc Ninh hoặc chuyển tiếp vào TP.HCM; lô lớn, không gấp có thể đi đường biển. ${timeSentence} ` +
  `Có hai cách làm thủ tục: ký gửi trọn gói (không kèm chứng từ nhập khẩu) hoặc nhập khẩu chính ngạch (có tờ khai hải quan, hưởng thuế ưu đãi nếu có C/O Form E).`;

// ── FAQ riêng trang. `pending` = câu trả lời phụ thuộc dữ kiện chưa xác minh → không vào FAQPage.
const faq: FaqItem[] = [
  {
    q: 'Thời gian vận chuyển từ Thâm Quyến về Việt Nam mất bao lâu?',
    a: hn && hcm
      ? `Đường bộ: Thâm Quyến – Hà Nội ${hn}, Thâm Quyến – TP.HCM ${hcm}. Hàng nhập khẩu chính ngạch cộng thêm thời gian thông quan tùy luồng kiểm tra; đường biển chậm hơn nhưng rẻ hơn cho lô lớn.`
      : `Thời gian phụ thuộc hình thức vận chuyển, loại hàng và thủ tục hải quan. Gọi hoặc nhắn Zalo ${pretty} để được báo thời gian cho lô hàng cụ thể.`,
    pending: !(hn && hcm) || tr['Hà Nội'].isSample,
  },
  {
    q: `Địa chỉ kho Thâm Quyến của ${provider.name} ở đâu?`,
    a: `Địa chỉ nhận hàng tại Thâm Quyến và mẫu ghi thông tin người nhận được cung cấp sau khi bạn đăng ký mã khách hàng trên viporder.com.vn và liên hệ hotline / Zalo ${pretty}. Luôn ghi mã khách hàng trên từng kiện để kho nhận đúng hàng.`,
    pending: served.value === null || served.isSample,
  },
  {
    q: 'Quy trình tính phí quy đổi thể tích hàng hóa như thế nào?',
    a: `Đo dài × rộng × cao của kiện (cm). Số khối (m³) = D × R × C ÷ 1.000.000. Cân nặng quy đổi (kg) = D × R × C ÷ hệ số quy đổi${divisor.value ? ` (${divisor.value})` : ''}. Cước tính theo giá trị lớn hơn giữa cân nặng thực và cân nặng quy đổi; hàng lô cồng kềnh thường tính thẳng theo m³.`,
    pending: divisor.value === null || divisor.isSample,
  },
  {
    q: 'Hàng từ Thâm Quyến có nhập khẩu chính ngạch được không?',
    a: `Có. ${provider.name} hỗ trợ nhập khẩu chính ngạch và khai báo hải quan với bộ chứng từ phù hợp theo mặt hàng. Nếu nhà cung cấp cấp được C/O Form E, doanh nghiệp có thể được hưởng thuế suất ưu đãi theo Hiệp định ASEAN – Trung Quốc (ACFTA).`,
  },
  {
    q: 'Kho Thâm Quyến ở đây có phải kho Thâm Quyến của Shopee không?',
    a: `Không. "Kho Thâm Quyến" hiển thị trên Shopee là kho của sàn dành cho đơn hàng quốc tế đặt trên Shopee. Trang này nói về dịch vụ vận chuyển hàng từ nhà cung cấp tại Thâm Quyến về Việt Nam do ${provider.name} vận hành — dành cho doanh nghiệp, xưởng và chủ shop tự nhập hàng.`,
  },
];
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.filter((f) => !f.pending).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const ld = [
  {
    ...serviceLd({
      name: 'Vận chuyển hàng từ Thâm Quyến về Việt Nam',
      serviceType: 'Vận chuyển hàng hóa quốc tế Trung Quốc – Việt Nam và thủ tục hải quan',
      description: page.description,
      url,
      areaServed: ['Việt Nam'],
    }),
    // Điểm đi của tuyến (Thâm Quyến) — dữ kiện địa lý, không phải cam kết kho.
    availableChannel: { '@type': 'ServiceChannel', servicePhone: { '@type': 'ContactPoint', telephone: provider.hotline.replace(/^0/, '+84'), contactType: 'customer service', availableLanguage: ['vi'] } },
  },
  { '@type': 'WebPage', '@id': `${url.href}#webpage`, url: url.href, name: page.h1, inLanguage: 'vi', dateModified: R.updated, isPartOf: { '@id': new URL('/#organization', site).href } },
  ...(faqLd.mainEntity.length ? [faqLd] : []),
];
const steps = [
  { title: processSteps[0].title, text: processSteps[0].text },
  { title: 'Nhận địa chỉ kho Thâm Quyến', text: `Gọi hoặc nhắn Zalo ${pretty} để nhận địa chỉ nhận hàng và mẫu ghi mã khách hàng trên kiện.` },
  { title: 'Nhà cung cấp giao hàng tới kho', text: 'Báo nhà cung cấp gửi hàng (kèm mã vận đơn nội địa Trung Quốc) và ghi đúng mã khách hàng trên từng kiện.' },
  { title: 'Vận chuyển và thông quan', text: 'Hàng được vận chuyển về Việt Nam theo hình thức đã chọn; hàng chính ngạch làm tờ khai hải quan.' },
  { title: processSteps[2].title, text: processSteps[2].text },
  { title: 'Nhận hàng / giao tận nơi', text: 'Nhận tại kho hoặc giao tận nơi (door to door) theo phương án đã thỏa thuận khi báo giá.' },
];
---
<LogisticsLayout page={page} jsonLd={ld}>
  <section class="section sz-answer" aria-labelledby="sz-sum">
    <div class="container">
      <div class="answer-box">
        <h2 id="sz-sum" class="answer-title">Tóm tắt nhanh</h2>
        <p class="answer">{answer}</p>
        {anySample && <p class="sample-note"><span class="sample-tag">MẪU</span> Số liệu thời gian là dữ liệu mẫu chưa xác minh.</p>}
        <p class="updated">Cập nhật: <time datetime={R.updated}>{updatedVi}</time> · Đơn vị vận hành: {provider.name} ({provider.legalName})</p>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="sz-time">
    <div class="container">
      <span class="kicker">Thời gian</span>
      <h2 id="sz-time">Thời gian vận chuyển từ Thâm Quyến về các tỉnh thành (Hà Nội, TP.HCM, Lạng Sơn, Bắc Ninh)</h2>
      <div class="table-wrap">
        <table class="data-table">
          <caption>Thời gian vận chuyển đường bộ tham khảo từ Thâm Quyến, tính từ khi hàng nhập kho Trung Quốc</caption>
          <thead><tr><th scope="col">Tuyến</th><th scope="col">Thời gian dự kiến</th><th scope="col">Ghi chú</th></tr></thead>
          <tbody>
            {R.destinations.map((d) => (
              <tr><th scope="row">Thâm Quyến → {d.city}</th><td><Pending fact={d.transit} fallback="Báo theo lô hàng" /></td><td>{d.note}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="grid sz-modes">
        <article class="card">
          <h3>Vận chuyển đường bộ (chuyển phát nhanh)</h3>
          <p>Tuyến phổ biến nhất cho hàng từ Thâm Quyến: hàng gom theo kiện, đi xe tải qua cửa khẩu đường bộ biên giới phía Bắc rồi về kho tại Việt Nam. Phù hợp đơn nhỏ, hàng mẫu và hàng cần nhanh.</p>
          <p class="muted">Thời gian về Hà Nội: <Pending fact={R.destinations[0].transit} fallback="báo theo lô hàng" /></p>
        </article>
        <article class="card">
          <h3>Vận chuyển chính ngạch &amp; kê khai thủ tục hải quan</h3>
          <p>Doanh nghiệp đứng tên nhập khẩu, mở tờ khai hải quan, nộp thuế nhập khẩu và thuế GTGT khâu nhập khẩu, có đủ chứng từ hạch toán. {provider.name} hỗ trợ khai báo hải quan và chuẩn bị bộ chứng từ phù hợp theo mặt hàng.</p>
          <ul class="check-list">
            <li>Hợp đồng, hóa đơn thương mại, phiếu đóng gói (packing list)</li>
            <li>C/O Form E nếu muốn hưởng thuế ưu đãi ACFTA</li>
            <li>Giấy phép / kiểm tra chuyên ngành nếu mặt hàng yêu cầu</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="sz-price">
    <div class="container">
      <span class="kicker">Bảng giá</span>
      <h2 id="sz-price">Bảng giá cước ký gửi hàng Thâm Quyến về Việt Nam 2026</h2>
      <p class="muted">So sánh các hình thức vận chuyển từ Thâm Quyến. Cước cụ thể phụ thuộc cân nặng, số khối, loại hàng và nơi nhận.</p>
      <div class="table-wrap">
        <table class="data-table compare">
          <caption>So sánh hình thức vận chuyển Thâm Quyến – Việt Nam: cách tính cước, thời gian, chứng từ, cước tham khảo</caption>
          <thead><tr><th scope="col">Hình thức</th><th scope="col">Tính cước theo</th><th scope="col">Thời gian về Hà Nội</th><th scope="col">Chứng từ</th><th scope="col">Phù hợp</th><th scope="col">Cước tham khảo</th></tr></thead>
          <tbody>
            {modes.map((m) => (
              <tr>
                <th scope="row">{m.name}<span class="how">{m.how}</span></th>
                <td>{m.unit}</td>
                <td><Pending fact={m.transitHanoi} fallback="Báo theo lô" /></td>
                <td>{m.papers}</td>
                <td>{m.fit}</td>
                <td><Pending fact={m.price} fallback="Báo theo lô" /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="sz-links">
        <a class="text-link" href="/logistics/bang-gia/#form-lien-he">Gửi yêu cầu báo giá &amp; tính số khối →</a>
      </p>
      <h3>Cách tính cân nặng quy đổi</h3>
      <p>Số khối (m³) = dài × rộng × cao (cm) ÷ 1.000.000. Cân nặng quy đổi (kg) = dài × rộng × cao (cm) ÷ hệ số quy đổi (hệ số: <Pending fact={{ ...volumetricDivisor, value: volumetricDivisor.value === null ? null : String(volumetricDivisor.value), sample: volumetricDivisor.sample === undefined ? undefined : String(volumetricDivisor.sample) }} fallback="ghi trong báo giá" />). Ví dụ kiện 60 × 50 × 40 cm có thể tích 0,12 m³. Cước thường tính theo giá trị lớn hơn giữa cân nặng thực và cân nặng quy đổi.</p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="sz-flow">
    <div class="container">
      <span class="kicker">Quy trình</span>
      <h2 id="sz-flow">Quy trình nhận hàng tại kho Thâm Quyến và giao tận nơi (Door to Door)</h2>
      <ol class="sz-steps">
        {steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
      </ol>
      <a class="btn btn-primary" href={provider.registerUrl} rel="noopener" target="_blank" data-track="register_click" data-track-location="tham_quyen_flow" data-track-route="tham-quyen">Đăng ký mã khách hàng<span class="visually-hidden"> (mở tab mới)</span></a>
    </div>
  </section>

  <section class="section" aria-labelledby="sz-fit">
    <div class="container split">
      <div>
        <h2 id="sz-fit">Hàng nhập từ Thâm Quyến thường là gì?</h2>
        <ul class="check-list">
          <li>Linh kiện, bo mạch, thiết bị điện tử</li>
          <li>Phụ kiện điện thoại, máy tính, thiết bị thông minh</li>
          <li>Đèn LED, thiết bị điện, máy móc nhỏ</li>
          <li>Hàng từ nhà cung cấp, nhà máy khu vực Thâm Quyến – Đông Quản</li>
        </ul>
        {linkable('/logistics/kien-thuc/c-o-form-e-va-ma-hs-hang-tham-quyen/') && <p><a class="text-link" href="/logistics/kien-thuc/c-o-form-e-va-ma-hs-hang-tham-quyen/">C/O Form E và mã HS cho hàng Thâm Quyến →</a></p>}
      </div>
      <div>
        <h2>Xem thêm</h2>
        <ul class="link-list">
          <li><a class="text-link" href="/logistics/van-chuyen-trung-quoc-viet-nam/">Vận chuyển hàng Trung Quốc về Việt Nam</a></li>
          <li><a class="text-link" href="/logistics/van-chuyen-trung-quoc-bac-ninh/">Nhận hàng tại Bắc Ninh</a></li>
          <li><a class="text-link" href="/logistics/quy-trinh-gui-hang/">Quy trình gửi hàng</a></li>
          <li><a class="text-link" href="/logistics/tra-cuu-van-don/">Tra cứu vận đơn</a></li>
          <li><a class="text-link" href="/cong-ty-thanh-vien/">Công ty thành viên VIP GROUP</a></li>
          <li><a class="text-link" href="/">Trang chủ VIP GROUP</a></li>
          <li><a class="text-link" href={provider.url} rel="noopener" target="_blank" data-track="provider_site_click" data-track-location="tham_quyen_links">viporder.com.vn<span class="visually-hidden"> (mở tab mới)</span></a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="sz-faq">
    <div class="container split">
      <div>
        <h2 id="sz-faq">Câu hỏi thường gặp về vận chuyển Thâm Quyến – Việt Nam</h2>
        <p class="muted">Chưa thấy câu trả lời? Gọi / Zalo <a class="text-link" href={telHref(provider.hotline)} data-track="call_click" data-track-location="tham_quyen_faq" data-track-route="tham-quyen">{pretty}</a>.</p>
      </div>
      <FaqList items={faq} />
    </div>
  </section>
</LogisticsLayout>
<style>
  .sz-answer { padding-bottom: 0; }
  .answer-box { border-left: 4px solid var(--brand); background: var(--bg-alt); border-radius: var(--radius-sm); padding: 20px 24px; max-width: 900px; }
  .answer-title { font-size: 18px; margin-bottom: 8px; }
  .answer { margin: 0 0 10px; font-size: 17px; line-height: 1.65; }
  .updated, .sample-note { margin: 0; font-size: 14px; color: var(--muted); }
  .sample-tag { display: inline-block; padding: 1px 6px; border-radius: 6px; font-size: 11px; font-weight: 800; color: #fff; background: #6b4e00; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg); margin: 16px 0 24px; }
  .data-table { width: 100%; border-collapse: collapse; min-width: 560px; }
  .data-table.compare { min-width: 860px; }
  .data-table caption { caption-side: top; text-align: left; padding: 12px 18px 0; font-size: 14px; color: var(--muted); }
  .data-table th, .data-table td { padding: 14px 18px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .data-table thead th { background: var(--bg-alt); font-size: 14px; }
  .data-table tbody tr:last-child > * { border-bottom: 0; }
  .data-table .how { display: block; margin-top: 4px; font-weight: 400; font-size: 14px; color: var(--muted); }
  .sz-modes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 760px) { .sz-modes { grid-template-columns: 1fr; } }
  .sz-links { margin: 0 0 28px; }
  .sz-steps { counter-reset: s; list-style: none; margin: 0 0 24px; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .sz-steps li { counter-increment: s; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 18px 20px; }
  .sz-steps li::before { content: counter(s); display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--brand); color: var(--on-brand); font-weight: 800; margin-bottom: 8px; }
  .sz-steps h3 { font-size: 17px; margin-bottom: 6px; }
  .sz-steps p { margin: 0; color: var(--text-2); }
  .link-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
</style>
