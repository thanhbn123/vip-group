---
import { priceOffers } from '../lib/pricing';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectorGrid from '../components/SectorGrid.astro';
import MemberGrid from '../components/MemberGrid.astro';
import NewsList from '../components/NewsList.astro';
import CtaBand from '../components/CtaBand.astro';
import MemberNote from '../components/MemberNote.astro';
import PriceTable from '../components/PriceTable.astro';
import { getContent } from '../data';
import { heroBanner } from '../data/vi/hero';
const hb = heroBanner;
const heroSrcset = hb ? hb.widths.map((w) => `${hb.base}-${w}.webp ${w}w`).join(', ') : '';
import { linkable } from '../lib/logistics';

const { company, sectors, subsidiaries, news, careers, contact, pricing } = getContent('vi');
const site = Astro.site!;
// schema.org Service + Offer theo từng mức giá (VND/kg). Không khai thời gian giao, phụ phí, đánh giá.
const priceLd = {
  '@type': 'Service',
  name: pricing.title,
  serviceType: 'Vận chuyển hàng hóa Trung Quốc – Việt Nam',
  url: new URL('/#bang-gia', site).href,
  brand: { '@id': new URL('/#organization', site).href },
  areaServed: { '@type': 'Country', name: 'Việt Nam' },
  offers: priceOffers(pricing.tiers),
};
const sloganParts = company.slogan.split(' - ').map((s) => s.trim());
const sloganLast = sloganParts.pop();
---
<BaseLayout title="Trang chủ" description={company.tagline} jsonLd={[priceLd]}>
  <section class:list={['hero', { 'hero--banner': heroBanner }]} aria-labelledby="hero-title">
    {heroBanner && (
      <picture class="hero-photo">
        <source type="image/webp" srcset={heroSrcset}
          sizes="(max-width: 900px) 100vw, 62vw" />
        <img src={`${heroBanner.base}-${heroBanner.widths[0]}.jpg`} alt={heroBanner.alt} width={heroBanner.width} height={heroBanner.height} fetchpriority="high" decoding="async" />
      </picture>
    )}
    <div class="container hero-grid">
      <div class="hero-text">
        {heroBanner && (
          <picture class="hero-logo">
            <source srcset="/logo-vip-group-400.webp 400w, /logo-vip-group-600.webp 600w" sizes="140px" type="image/webp" />
            <img src="/logo-vip-group.png" alt={`Logo ${company.name}`} width="720" height="661" />
          </picture>
        )}
        <span class="kicker">{company.legalName ?? company.name}</span>
        <h1 id="hero-title">{sloganParts.map((p) => <>{p}.<br /></>)}<span class="nhan">{sloganLast}.</span></h1>
        <p class="lead">{company.tagline}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/linh-vuc-hoat-dong/">Khám phá hệ sinh thái</a>
          <a class="btn btn-ghost" href="/lien-he/">Liên hệ hợp tác</a>
        </div>
      </div>
      {!heroBanner && (
        <div class="hero-card">
        <picture>
          <source srcset="/logo-vip-group-400.webp 400w, /logo-vip-group-600.webp 600w, /logo-vip-group.webp 720w" sizes="(max-width: 900px) min(420px, calc(100vw - 72px)), 400px" type="image/webp" />
          <img src="/logo-vip-group.png" alt={`Logo ${company.name}`} width="720" height="661" fetchpriority="high" />
        </picture>
        </div>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="about-title">
    <div class="container split">
      <div>
        <span class="kicker">Giới thiệu</span>
        <h2 id="about-title">{company.about.heading}</h2>
      </div>
      <div class="prose">
        {company.intro.map((p) => <p>{p}</p>)}
        <a class="text-link" href="/gioi-thieu/">Tìm hiểu thêm về {company.name} →</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="sectors-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Lĩnh vực hoạt động</span>
          <h2 id="sectors-title">Ba trụ cột phát triển</h2>
        </div>
        <a class="text-link" href="/linh-vuc-hoat-dong/">Xem chi tiết →</a>
      </div>
      <SectorGrid sectors={sectors} />
    </div>
  </section>

  <PriceTable pricing={pricing} slogan={company.slogan} brand={company.name} hotline={contact.hotline} hotlineDisplay={contact.hotlineDisplay} zaloUrl={contact.zaloUrl}
    quoteHref={contact.formBackendReady ? '/lien-he/?nhu-cau=bao-gia-van-chuyen#form-lien-he' : null} detailHref="/logistics/bang-gia/"
    relatedLinks={[
      { href: '/logistics/van-chuyen-trung-quoc-bac-ninh/', label: 'Vận chuyển hàng Trung Quốc về Bắc Ninh' },
      { href: '/logistics/van-chuyen-tham-quyen-ve-viet-nam/', label: 'Vận chuyển Thâm Quyến về Việt Nam' },
    ].filter((l) => linkable(l.href))} />

{subsidiaries.length > 0 && (
  <section class="section" aria-labelledby="members-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Hệ sinh thái</span>
          <h2 id="members-title">Công ty thành viên</h2>
        </div>
        <a class="text-link" href="/cong-ty-thanh-vien/">Xem tất cả →</a>
      </div>
      <MemberGrid subsidiaries={subsidiaries} sectors={sectors} />
      <MemberNote />
    </div>
  </section>
  )}

  <section class="section section-alt" aria-labelledby="news-title">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker">Tin tức</span>
          <h2 id="news-title">Tin mới</h2>
        </div>
        <a class="text-link" href="/tin-tuc/">Xem tất cả →</a>
      </div>
      <NewsList items={news} limit={3} />
    </div>
  </section>

  <section class="section" aria-labelledby="careers-title">
    <div class="container split">
      <div>
        <span class="kicker">Tuyển dụng</span>
        <h2 id="careers-title">Gia nhập {company.name}</h2>
      </div>
      <div class="prose">
        <p>{careers.intro}</p>
        <a class="btn btn-ghost" href="/tuyen-dung/">Cơ hội nghề nghiệp</a>
      </div>
    </div>
  </section>

  <CtaBand title="Hợp tác cùng VIP GROUP" text="Kết nối với chúng tôi để trao đổi về cơ hội hợp tác trong ba lĩnh vực hoạt động." />
</BaseLayout>

<style>
  .hero { min-height: calc(100svh - var(--header-h)); display: flex; align-items: center; background: radial-gradient(circle at 12% 18%, rgba(208, 7, 26, .08), transparent 32%), radial-gradient(circle at 88% 30%, rgba(208, 7, 26, .06), transparent 30%), linear-gradient(145deg, var(--bg), var(--bg-soft)); }
  .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; padding: 72px 0; }
  .nhan { color: var(--brand); }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .hero-card { border-radius: 32px; padding: clamp(20px, 3vw, 36px); background: var(--bg); border: 1px solid var(--line); box-shadow: var(--shadow); max-width: 460px; justify-self: center; width: 100%; }
  .hero-card img { width: 100%; height: auto; display: block; }
  /* ── Biến thể banner (owner 07/11/2026): ảnh xe hàng bên trái, logo + slogan đỏ in hoa bên phải ── */
  .hero--banner { position: relative; min-height: min(640px, calc(100svh - var(--header-h))); background: linear-gradient(90deg, #eef3f9 0%, #dde7f3 100%); overflow: hidden; }
  .hero--banner .hero-photo { position: absolute; inset: 0 38% 0 0; }
  .hero--banner .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 40% 60%; }
  .hero--banner .hero-photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, transparent 55%, #dde7f3 100%); }
  .hero--banner .hero-grid { position: relative; grid-template-columns: 1fr; justify-items: end; padding: 56px 0; }
  .hero--banner .hero-text { width: min(470px, 40%); text-align: center; display: flex; flex-direction: column; align-items: center; }
  .hero--banner .hero-logo img { width: 140px; height: auto; margin: 0 auto 4px; }
  .hero--banner h1 { color: var(--brand); text-transform: uppercase; font-size: clamp(32px, 4vw, 56px); letter-spacing: 0; line-height: 1.12; }
  .hero--banner .nhan { color: var(--brand); }
  .hero--banner .lead { font-size: 16px; color: var(--text-2); }
  .hero--banner .hero-actions { justify-content: center; }
  @media (max-width: 900px) {
    .hero--banner { display: block; min-height: 0; background: #e6edf6; }
    .hero--banner .hero-photo { position: relative; inset: auto; display: block; aspect-ratio: 16 / 10; }
    .hero--banner .hero-photo::after { background: linear-gradient(180deg, transparent 70%, #e6edf6 100%); }
    .hero--banner .hero-grid { justify-items: center; padding: 8px 0 40px; }
    .hero--banner .hero-text { width: 100%; }
    .hero--banner .hero-logo img { width: 96px; }
    .hero--banner h1 { font-size: clamp(30px, 9vw, 40px); }
  }
  @media (max-width: 900px) {
    .hero { min-height: auto; }
    .hero-grid { grid-template-columns: 1fr; gap: 32px; padding: 56px 0; }
    .hero-card { max-width: 420px; width: 100%; }
  }
</style>
