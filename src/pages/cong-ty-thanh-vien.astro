---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MemberGrid from '../components/MemberGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import MemberNote from '../components/MemberNote.astro';
import { getContent } from '../data';

const { company, sectors, subsidiaries } = getContent('vi');
const active = subsidiaries.filter((s) => s.status === 'active').map((s) => s.name);
const desc = active.length
  ? `Hệ sinh thái công ty thành viên của ${company.name}: ${active.join(', ')}.`
  : `Thông tin công ty thành viên của ${company.name}. Hiện các lĩnh vực do ${company.legalName} trực tiếp thực hiện theo ngành nghề đăng ký.`;
---
<BaseLayout title="Công ty thành viên" description={desc}>
  <PageHero kicker="Công ty thành viên" title={`Hệ sinh thái ${company.name}`} lead={`Các lĩnh vực Xuất nhập khẩu – Hải quan – Logistics, Công nghệ – Phần mềm – AI và Bất động sản hiện do ${company.legalName} trực tiếp thực hiện.`} />
  <section class="section" aria-label="Danh sách công ty thành viên">
    <div class="container">
      {subsidiaries.length > 0 && <MemberGrid subsidiaries={subsidiaries} sectors={sectors} headingLevel="h2" />}
      <MemberNote />
    </div>
  </section>
  <CtaBand title="Trở thành đối tác" text="Liên hệ để trao đổi cơ hội hợp tác với VIP GROUP." />
</BaseLayout>
