---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import MemberGrid from '../components/MemberGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import MemberNote from '../components/MemberNote.astro';
import { getContent } from '../data';

const { company, sectors, subsidiaries } = getContent('vi');
const active = subsidiaries.filter((s) => s.status === 'active').map((s) => s.name);
---
<BaseLayout title="Công ty thành viên" description={`Hệ sinh thái công ty thành viên của ${company.name}: ${active.join(', ')}.`}>
  <PageHero kicker="Công ty thành viên" title={`Hệ sinh thái ${company.name}`} lead="VIPORDER là công ty cùng chủ sở hữu với VIP GROUP, hoạt động trong trụ cột Xuất nhập khẩu – Hải quan – Logistics." />
  <section class="section" aria-label="Danh sách công ty thành viên">
    <div class="container">
      <MemberGrid subsidiaries={subsidiaries} sectors={sectors} headingLevel="h2" />
      <MemberNote />
    </div>
  </section>
  <CtaBand title="Trở thành đối tác" text="Liên hệ để trao đổi cơ hội hợp tác với VIP GROUP và các công ty thành viên." />
</BaseLayout>
