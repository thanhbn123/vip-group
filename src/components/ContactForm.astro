---
/**
 * Form liên hệ — GIAI ĐOẠN 1 CHỈ LÀ GIAO DIỆN.
 * Chưa có máy chủ nhận dữ liệu: form không có `action`, script chặn gửi và
 * báo rõ cho người dùng rằng dữ liệu CHƯA được gửi, kèm email thay thế.
 * Khi có backend: đặt contact.formBackendReady = true và nối API ở đây.
 */
interface Props { email: string; backendReady: boolean }
const { email, backendReady } = Astro.props;
---
<form class="contact-form card" data-contact-form data-email={email} novalidate={!backendReady}>
  {!backendReady && (
    <p class="notice" role="note">
      Form đang trong giai đoạn thử nghiệm và <strong>chưa gửi được dữ liệu</strong>.
      Vui lòng liên hệ qua email <a class="text-link" href={`mailto:${email}`}>{email}</a>.
    </p>
  )}
  <div class="field">
    <label for="cf-name">Họ và tên</label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="field-row">
    <div class="field">
      <label for="cf-phone">Số điện thoại</label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
    </div>
    <div class="field">
      <label for="cf-email">Email</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" required />
    </div>
  </div>
  <div class="field">
    <label for="cf-message">Nội dung</label>
    <textarea id="cf-message" name="message" rows="5" required></textarea>
  </div>
  <button class="btn btn-primary" type="submit">Gửi liên hệ</button>
  <p class="form-status" data-form-status role="status" aria-live="polite"></p>
</form>

<style>
  .contact-form { display: grid; gap: 16px; }
  .notice { margin: 0; padding: 12px 16px; border-radius: var(--radius-sm); background: rgba(217,182,111,.1); border: 1px solid rgba(217,182,111,.35); font-size: 14px; color: #e9dcc0; }
  .field { display: grid; gap: 6px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .field-row { grid-template-columns: 1fr; } }
  label { font-size: 14px; font-weight: 600; }
  input, textarea { width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--line); background: rgba(255,255,255,.04); color: var(--text); }
  input:focus-visible, textarea:focus-visible { border-color: var(--gold); }
  textarea { resize: vertical; }
  .form-status { margin: 0; font-size: 14px; color: var(--gold-light); min-height: 1.4em; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-form-status]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!status) return;
    const email = form.dataset.email ?? '';
    status.textContent = `Dữ liệu CHƯA được gửi — form chưa kết nối máy chủ. Vui lòng gửi email tới ${email}.`;
  });
</script>
