---
/**
 * Form liên hệ / yêu cầu báo giá.
 *
 * - `backendReady = false` (chưa cài Turnstile): CHỈ LÀ GIAO DIỆN như giai đoạn 1 — không dữ liệu nào rời trang.
 * - `backendReady = true` (VIPG-WEB-023): gửi JSON tới `/api/lead` (Cloudflare Function cùng tên miền, xem public/_worker.js)
 *   kèm mã Turnstile chống spam. Chỉ báo "đã nhận" khi máy chủ xác nhận đã lưu.
 *
 * Ở CẢ HAI chế độ: ô nhập KHÔNG có `name`, form KHÔNG có `action`, nút gửi `disabled` sẵn → tắt JS không gửi được gì
 * (CSP vẫn `form-action 'none'`; JS gửi bằng fetch, không submit form).
 */
interface Props {
  email: string;
  backendReady: boolean;
  hotline?: string | null;
  lead?: { endpoint: string; turnstileSiteKey: string | null; privacyHref: string };
  /** Nhu cầu chọn sẵn (vd. trang bảng giá → báo giá vận chuyển). */
  defaultNeed?: string;
}
const { email, backendReady, hotline = null, lead, defaultNeed } = Astro.props;
const ready = backendReady && !!lead?.turnstileSiteKey;
const tel = hotline?.replace(/\s/g, '') ?? '';
const pretty = tel.replace(/^(\d{4})(\d{3})(\d{3})$/, '$1 $2 $3');
const routes = [
  ['tham-quyen', 'Thâm Quyến (深圳)'],
  ['quang-chau', 'Quảng Châu (广州)'],
  ['ha-mon', 'Hạ Môn (厦门)'],
  ['nghia-o', 'Nghĩa Ô (义乌)'],
  ['khac', 'Nơi khác tại Trung Quốc'],
  ['chua-ro', 'Chưa rõ — cần tư vấn'],
];
const needs = [
  ['bao-gia-van-chuyen', 'Báo giá vận chuyển Trung Quốc – Việt Nam'],
  ['nhap-khau-chinh-ngach', 'Nhập khẩu chính ngạch / hải quan'],
  ['hop-tac', 'Hợp tác'],
  ['khac', 'Khác'],
];
---
<form class="contact-form card" id="form-lien-he" data-contact-form data-email={email} data-backend-ready={String(ready)}
  data-endpoint={ready ? lead!.endpoint : undefined} data-hotline={tel || undefined} novalidate={ready}>
  {!ready && (
    <p class="notice" role="note">
      Form đang trong giai đoạn thử nghiệm và <strong>chưa gửi được dữ liệu</strong>.
      Vui lòng liên hệ qua email <a class="text-link" href={`mailto:${email}`}>{email}</a>.
    </p>
  )}
  {ready && (
    <noscript><p class="notice">Trình duyệt đang tắt JavaScript nên không gửi được form. Vui lòng gọi hoặc nhắn Zalo {pretty}.</p></noscript>
  )}
  <div class="field">
    <label for="cf-name">Họ và tên</label>
    <input id="cf-name" type="text" autocomplete="name" required maxlength="80" />
  </div>
  <div class="field-row">
    <div class="field">
      <label for="cf-phone">Số điện thoại{ready && ' / Zalo'}</label>
      <input id="cf-phone" type="tel" autocomplete="tel" inputmode="tel" required={ready} maxlength="20" />
    </div>
    <div class="field">
      <label for="cf-email">Email{ready && ' (không bắt buộc)'}</label>
      <input id="cf-email" type="email" autocomplete="email" required={!ready} maxlength="120" />
    </div>
  </div>
  {ready && (
    <div class="field">
      <label for="cf-route">Tuyến vận chuyển — hàng gửi từ đâu tại Trung Quốc?</label>
      <select id="cf-route">{routes.map(([v, l]) => <option value={v} selected={v === 'chua-ro'}>{l}</option>)}</select>
    </div>
  )}
  {ready && (
    <div class="field-row">
      <div class="field">
        <label for="cf-need">Nhu cầu</label>
        <select id="cf-need">{needs.map(([v, l]) => <option value={v} selected={v === defaultNeed}>{l}</option>)}</select>
      </div>
      <div class="field">
        <label for="cf-weight">Khối lượng ước tính (kg)</label>
        <input id="cf-weight" type="number" min="0" step="0.1" inputmode="decimal" />
      </div>
    </div>
  )}
  <div class="field">
    <label for="cf-message">Nội dung</label>
    <textarea id="cf-message" rows="5" required={!ready} maxlength="1000"></textarea>
  </div>
  {ready && (
    <>
      <div class="hp" aria-hidden="true">
        <label for="cf-website">Website</label>
        <input id="cf-website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <label class="consent" for="cf-consent">
        <input id="cf-consent" type="checkbox" required />
        <span>Tôi đồng ý để CÔNG TY TNHH VIP GROUP dùng thông tin trên để liên hệ, tư vấn theo{' '}
          <a class="text-link" href={lead!.privacyHref}>Chính sách bảo mật</a>.</span>
      </label>
      <div class="cf-turnstile" data-sitekey={lead!.turnstileSiteKey} data-language="vi"></div>
      <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    </>
  )}
  <button class="btn btn-primary" type="submit" disabled data-submit>Gửi liên hệ</button>
  <p class="form-status" data-form-status role="status" aria-live="polite"></p>
</form>

<style>
  .contact-form { display: grid; gap: 16px; scroll-margin-top: calc(var(--header-h) + 16px); }
  .notice { margin: 0; padding: 12px 16px; border-radius: var(--radius-sm); background: rgba(208, 7, 26, .05); border: 1px solid rgba(208, 7, 26, .25); font-size: 14px; color: var(--text-2); }
  .field { display: grid; gap: 6px; min-width: 0; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .field-row { grid-template-columns: 1fr; } }
  label { font-size: 14px; font-weight: 600; }
  input, textarea, select { width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: var(--bg); color: var(--text); }
  input:focus-visible, textarea:focus-visible, select:focus-visible { border-color: var(--brand); }
  input[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
  textarea { resize: vertical; }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; font-size: 14px; color: var(--text-2); }
  .consent input { width: 20px; height: 20px; margin-top: 2px; flex: none; accent-color: var(--brand); }
  .cf-turnstile { min-height: 65px; }
  button[disabled] { opacity: .55; cursor: not-allowed; transform: none; }
  .form-status { margin: 0; font-size: 15px; color: var(--brand-ink); min-height: 1.4em; }
  .form-status.ok { color: #116b2f; font-weight: 600; }
</style>

<script>
  type TS = { getResponse: (el?: Element) => string | undefined; reset: (el?: Element) => void };
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const say = (msg: string, ok = false) => { if (status) { status.textContent = msg; status.classList.toggle('ok', ok); } };
    if (submit) submit.disabled = false;

    if (form.dataset.backendReady !== 'true') {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        say(`Dữ liệu CHƯA được gửi — form chưa kết nối máy chủ. Vui lòng gửi email tới ${form.dataset.email ?? ''}.`);
      });
    } else {
      const $ = <T extends HTMLElement>(id: string) => form.querySelector<T>(`#${id}`)!;
      const hotline = form.dataset.hotline ?? '';
      const startedAt = Date.now();
      const key = (crypto.randomUUID?.() ?? `${Date.now()}-${Math.random().toString(36).slice(2)}`).replace(/[^A-Za-z0-9-]/g, '');
      const params = new URLSearchParams(location.search);
      const preset = params.get('nhu-cau');
      if (preset) { const sel = $<HTMLSelectElement>('cf-need'); if ([...sel.options].some((o) => o.value === preset)) sel.value = preset; }
      // Đăng ký khách hàng (tạm thời, trước khi có cổng khách hàng riêng): need giữ 'khac' (hợp đồng CRM V5), điền sẵn nội dung.
      if (params.get('dang-ky') === '1') {
        const msg = $<HTMLTextAreaElement>('cf-message');
        if (!msg.value) msg.value = 'Đăng ký khách hàng VIP GROUP — đề nghị cấp mã khách hàng.';
      }
      const ref = document.referrer ? new URL(document.referrer).host : '';
      const utm = {
        source: params.get('utm_source') ?? (ref && ref !== location.host ? ref : ''),
        medium: params.get('utm_medium') ?? '',
        campaign: params.get('utm_campaign') ?? '',
      };
      const phoneOk = (v: string) => /^0(3|5|7|8|9)\d{8}$/.test(v.replace(/[\s.\-()]/g, '').replace(/^\+84/, '0'));
      const track = (event: string, data: Record<string, unknown> = {}) => {
        const w = window as Window & { dataLayer?: unknown[] };
        (w.dataLayer = w.dataLayer || []).push({ event, page_path: location.pathname, ...data });
      };
      let sending = false;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (sending) return;
        const name = $<HTMLInputElement>('cf-name');
        const phone = $<HTMLInputElement>('cf-phone');
        const email = $<HTMLInputElement>('cf-email');
        const consent = $<HTMLInputElement>('cf-consent');
        const checks: [HTMLInputElement, boolean][] = [
          [name, name.value.trim().length >= 2],
          [phone, phoneOk(phone.value)],
          [email, email.value.trim() === '' || email.checkValidity()],
          [consent, consent.checked],
        ];
        checks.forEach(([el, ok]) => el.setAttribute('aria-invalid', String(!ok)));
        const bad = checks.find(([, ok]) => !ok);
        if (bad) {
          say(bad[0] === phone ? 'Số điện thoại chưa đúng (10 chữ số, bắt đầu bằng 0).' : bad[0] === consent ? 'Vui lòng đồng ý với chính sách bảo mật để gửi.' : 'Vui lòng kiểm tra lại các ô được đánh dấu.');
          bad[0].focus();
          return;
        }
        const ts = (window as Window & { turnstile?: TS }).turnstile;
        const token = ts?.getResponse(form.querySelector('.cf-turnstile') ?? undefined) ?? '';
        if (!token) { say('Vui lòng chờ ô xác minh chống spam hoàn tất rồi bấm gửi lại.'); return; }
        sending = true;
        if (submit) submit.disabled = true;
        say('Đang gửi…');
        const fail = (msg: string) => { say(msg); sending = false; if (submit) submit.disabled = false; ts?.reset(form.querySelector('.cf-turnstile') ?? undefined); };
        try {
          const r = await fetch(form.dataset.endpoint!, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              name: name.value, phone: phone.value, email: email.value,
              need: $<HTMLSelectElement>('cf-need').value, route: $<HTMLSelectElement>('cf-route').value, weight_kg: $<HTMLInputElement>('cf-weight').value,
              message: $<HTMLTextAreaElement>('cf-message').value, consent: consent.checked,
              website: $<HTMLInputElement>('cf-website').value, started_at: startedAt,
              idempotency_key: key, turnstile_token: token, page: location.pathname, utm,
            }),
          });
          const d = await r.json().catch(() => ({}));
          if (r.ok && d.ok) {
            track('lead_submit', { need: $<HTMLSelectElement>('cf-need').value, route: $<HTMLSelectElement>('cf-route').value });
            form.querySelectorAll('input, select, textarea').forEach((el) => ((el as HTMLInputElement).disabled = true));
            say(`Đã nhận yêu cầu${d.lead_id ? ` (mã ${d.lead_id})` : ''}. Chúng tôi sẽ liên hệ lại sớm. Cần gấp: gọi/Zalo ${hotline}.`, true);
            return;
          }
          if (d.error === 'invalid') {
            for (const f of d.fields ?? []) form.querySelector(`#cf-${f === 'weight_kg' ? 'weight' : f}`)?.setAttribute('aria-invalid', 'true');
            fail('Vui lòng kiểm tra lại các ô được đánh dấu.');
          } else if (d.error === 'turnstile') {
            fail('Xác minh chống spam chưa đạt, vui lòng thử lại.');
          } else if (d.notified) {
            fail(`Hệ thống đang bận nhưng thông tin của bạn đã được chuyển tới nhân viên qua kênh dự phòng. Cần gấp: gọi/Zalo ${hotline}.`);
          } else {
            fail(`Chưa gửi được. Vui lòng gọi hoặc nhắn Zalo ${hotline}.`);
          }
        } catch {
          fail(`Mất kết nối, chưa gửi được. Vui lòng thử lại hoặc gọi/Zalo ${hotline}.`);
        }
      });
    }
  }
</script>
