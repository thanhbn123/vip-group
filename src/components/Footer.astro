---
import { t } from '../i18n/ui';
import { defaultLocale, type Locale } from '../i18n/config';
import { getContent } from '../data';

interface Props { locale?: Locale }
const { locale = defaultLocale } = Astro.props;
const ui = t(locale);
const { company, contact } = getContent(locale);
const nav = ui.nav.filter((n) => n.key !== 'home');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">{company.name}</p>
      <p class="muted">{company.slogan}</p>
      {company.legalName && <p class="legal">{company.legalName}</p>}
      {company.taxId && <p class="legal">Mã số doanh nghiệp: {company.taxId}</p>}
    </div>
    <nav aria-label="Liên kết cuối trang">
      <p class="footer-title">Khám phá</p>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p class="footer-title">Liên hệ</p>
      <ul>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li>Hotline: {contact.hotline ? <a href={`tel:${contact.hotline.replace(/\s/g, '')}`}>{contact.hotline}</a> : ui.updating}</li>
        <li>Địa chỉ: {contact.address ?? ui.updating}</li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} {company.legalName ?? company.name}</span>
    <span>{contact.domain}</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--brand-dark); color: var(--on-brand); padding: 56px 0 28px; font-size: 15px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: 32px; }
  .footer-brand { font-weight: 800; letter-spacing: .08em; font-size: 20px; margin-bottom: 8px; }
  .footer-title { font-weight: 700; margin-bottom: 12px; }
  .muted { color: rgba(255, 255, 255, .9); }
  .legal { color: rgba(255, 255, 255, .82); font-size: 13px; margin: 0 0 4px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; color: rgba(255, 255, 255, .88); }
  a:hover { color: #fff; text-decoration: underline; text-underline-offset: 4px; }
  .footer-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 40px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, .22); color: rgba(255, 255, 255, .82); font-size: 13px; }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
