---
/**
 * Logo chính thức VIP GROUP (owner gửi 24/10/2026, PNG nền trong suốt 2000×2000;
 * bản gốc trong design/). Header dùng biểu tượng tròn cắt từ logo gốc, đặt trên
 * huy hiệu nền trắng để giữ đúng màu xanh navy của chữ V, P trên header tối.
 */
interface Props { name: string }
const { name } = Astro.props;
---
<span class="logo">
  <span class="logo-badge">
    <picture>
      <source srcset="/logo-mark-40.webp 1x, /logo-mark.webp 2x" type="image/webp" />
      <img src="/logo-mark.png" alt="" width="40" height="40" decoding="async" />
    </picture>
  </span>
  <span class="logo-text">{name}</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; font-weight: 800; letter-spacing: .08em; }
  .logo-badge { width: 48px; height: 48px; border-radius: 50%; background: #fff; display: grid; place-items: center; box-shadow: 0 0 0 1px rgba(217,182,111,.5); }
  .logo-badge img { width: 40px; height: 40px; display: block; }
  .logo-text { font-size: 17px; white-space: nowrap; }
</style>
