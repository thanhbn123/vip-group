---
/**
 * Bảng giá vận chuyển Trung Quốc – Việt Nam song ngữ Việt – Trung trên trang chủ (VIPG-WEB-022).
 * Dữ liệu: src/data/vi/pricing.ts (nguồn: owner 06/11/2026). Bảng <table> có ngữ nghĩa để máy tìm kiếm
 * và trình đọc màn hình hiểu đúng; trên điện thoại vẫn là 2 cột, chữ lớn, không cuộn ngang.
 */
import type { ShippingPricing } from '../data';
interface Props {
  pricing: ShippingPricing; slogan: string; brand: string; hotline: string | null;
  /** Hotline hiển thị + Zalo từ cấu hình tập trung (src/data/vi/contact.ts). */
  hotlineDisplay?: string | null; zaloUrl?: string | null;
  quoteHref?: string | null; detailHref?: string | null;
}
const { pricing, slogan, brand, hotline, hotlineDisplay = null, zaloUrl = null, quoteHref = null, detailHref = null } = Astro.props;
const fmt = (n: number) => n.toLocaleString('vi-VN');
const updated = pricing.updated.split('-').reverse().join('/');
const tel = hotline?.replace(/\s/g, '');
const pretty = hotlineDisplay ?? tel?.replace(/^(\d{4})(\d{3})(\d{3})$/, '$1 $2 $3');
---
<section class="section price-section" id="bang-gia" aria-labelledby="price-title">
  <div class="container price-grid">
    <div class="price-intro">
      <span class="kicker">Bảng giá · <span lang="zh-CN">价格表</span></span>
      <h2 id="price-title">
        {pricing.title}
        <span class="title-zh" lang="zh-CN">{pricing.titleZh}</span>
        <span class="title-route">{pricing.route} / <span lang="zh-CN">{pricing.routeZh}</span></span>
      </h2>
      <p class="slogan"><strong>{brand}</strong> · {slogan}</p>
      <p class="muted">Đơn giá theo trọng lượng, đơn vị VNĐ/kg.</p>
      {tel && (
        <div class="price-actions">
          {quoteHref && <a class="btn btn-primary" href={quoteHref}>Gửi yêu cầu báo giá</a>}
          <a class:list={['btn', quoteHref ? 'btn-ghost' : 'btn-primary']} href={`tel:${tel}`} data-track="call_click" data-track-location="price_table">Gọi tư vấn: {pretty}</a>
          <a class="btn btn-ghost" href={zaloUrl ?? `https://zalo.me/${tel}`} rel="noopener" target="_blank">Nhắn Zalo<span class="visually-hidden"> (mở tab mới)</span></a>
        </div>
      )}
    </div>

    <div class="price-card">
      <table class="price-table">
        <caption class="visually-hidden">{pricing.title} — đơn vị {pricing.unit}</caption>
        <thead>
          <tr>
            <th scope="col">Trọng lượng <span class="th-zh" lang="zh-CN">重量</span></th>
            <th scope="col" class="num">Đơn giá <span class="th-zh" lang="zh-CN">单价</span></th>
          </tr>
        </thead>
        <tbody>
          {pricing.tiers.map((t) => (
            <tr>
              <th scope="row">
                <span class="w-vi">{t.label}</span>
                <span class="w-zh" lang="zh-CN">{t.labelZh}</span>
              </th>
              <td class="num">
                <span class="p">{fmt(t.price)}</span><span class="u">đ/kg</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <div class="price-notes">
        <p><strong>Đơn vị tính:</strong> {pricing.unit} · <span lang="zh-CN">单位：{pricing.unitZh}</span></p>
        <p>{pricing.basis} <span lang="zh-CN">{pricing.basisZh}</span></p>
        <p>{pricing.note} <span lang="zh-CN">{pricing.noteZh}</span></p>
        <p class="updated">Cập nhật: <time datetime={pricing.updated}>{updated}</time></p>
        {detailHref && <p><a class="text-link" href={detailHref}>Xem bảng giá chi tiết, cách tính số khối →</a></p>}
      </div>
    </div>
  </div>
</section>

<style>
  .price-section { background: linear-gradient(160deg, var(--bg), var(--bg-soft)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .price-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 48px; align-items: start; }
  @media (max-width: 900px) { .price-grid { grid-template-columns: 1fr; gap: 28px; } }
  .price-intro h2 { margin-bottom: 16px; }
  .title-route { display: block; margin-top: 8px; font-size: .5em; letter-spacing: 0; color: var(--text-2); font-weight: 700; }
  .title-zh { display: block; margin-top: 10px; font-size: .62em; letter-spacing: 0; color: var(--brand-ink); font-weight: 700; }
  .slogan { font-size: 17px; color: var(--text-2); margin-bottom: 8px; }
  .price-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .price-card { background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); overflow: hidden; }
  .price-table { width: 100%; border-collapse: collapse; }
  .price-table thead th { background: var(--brand); color: var(--on-brand); font-size: 14px; font-weight: 700; text-align: left; padding: 14px 24px; letter-spacing: .02em; }
  .price-table thead th.num { text-align: right; }
  .price-table .th-zh { font-weight: 500; opacity: .92; margin-left: 6px; }
  .price-table tbody th, .price-table tbody td { padding: 18px 24px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .price-table tbody tr:nth-child(even) { background: var(--bg-alt); }
  .price-table tbody th { text-align: left; font-weight: 400; }
  .w-vi { display: block; font-size: 17px; font-weight: 700; color: var(--text); line-height: 1.35; }
  .w-zh { display: block; font-size: 14px; color: var(--muted); margin-top: 2px; }
  .num { text-align: right; white-space: nowrap; }
  .p { font-size: 26px; font-weight: 800; color: var(--brand-ink); letter-spacing: -.01em; font-variant-numeric: tabular-nums; }
  .u { font-size: 14px; font-weight: 600; color: var(--muted); margin-left: 3px; }
  .price-notes { padding: 18px 24px 20px; font-size: 14px; color: var(--text-2); display: grid; gap: 6px; }
  .price-notes p { margin: 0; }
  .updated { color: var(--muted); }
  @media (max-width: 480px) {
    .price-table thead th, .price-table tbody th, .price-table tbody td, .price-notes { padding-left: 16px; padding-right: 16px; }
    .w-vi { font-size: 16px; }
    .p { font-size: 22px; }
  }
</style>
