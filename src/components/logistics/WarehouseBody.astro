---
import Pending from './Pending.astro';
import FaqList from './FaqList.astro';
import type { Warehouse, FaqItem } from '../../data/types';
import { warehouses, provider } from '../../data/vi/logistics';
import { telHref, prettyPhone } from '../../lib/logistics';

interface Props { warehouse: Warehouse }
const { warehouse: w } = Astro.props;
const other = warehouses.find((x) => x.id !== w.id)!;
const faq: FaqItem[] = [
  { q: `Làm sao nhận địa chỉ kho ${w.city}?`, a: `Đăng ký mã khách hàng ${provider.name}, sau đó gọi hoặc nhắn Zalo ${prettyPhone(provider.hotline)} để nhận địa chỉ kho ${w.city} và mẫu ghi thông tin người nhận.` },
  { q: `Hàng từ kho ${w.city} về Việt Nam mất bao lâu?`, a: 'Thời gian phụ thuộc loại hàng, thủ tục và lịch xe; thời gian cụ thể được báo theo từng lô hàng.', pending: true },
  { q: 'Có kiểm đếm, chụp ảnh hàng tại kho không?', a: 'Quy định kiểm đếm, chụp ảnh tại kho đang được cập nhật — vui lòng trao đổi trước nếu lô hàng cần kiểm tra kỹ.', pending: true },
];
---
<section class="section" aria-labelledby="wh-info">
  <div class="container split">
    <div>
      <span class="kicker">Thông tin kho</span>
      <h2 id="wh-info">Kho {w.city} ({w.cityZh})</h2>
      <p class="muted">Địa chỉ kho và cách ghi thông tin người nhận được cung cấp khi bạn đăng ký mã khách hàng và liên hệ đội ngũ {provider.name}.</p>
      <a class="btn btn-primary" href={provider.registerUrl} rel="noopener" target="_blank" data-track="register_click" data-track-location={`kho_${w.id}`} data-track-route={w.id}>Đăng ký mã khách hàng<span class="visually-hidden"> (mở tab mới)</span></a>
    </div>
    <dl class="info-table">
      <div><dt>Địa chỉ kho</dt><dd><Pending fact={w.address} /></dd></div>
      <div><dt>Giờ nhận hàng</dt><dd><Pending fact={w.receivingHours} fallback="Đang cập nhật" /></dd></div>
      <div><dt>Thông tin người nhận</dt><dd><Pending fact={w.receiver} fallback="Hướng dẫn khi đăng ký mã khách hàng" /></dd></div>
      <div><dt>Tuyến về Việt Nam</dt><dd><Pending fact={w.route} fallback="Đang cập nhật" /></dd></div>
      <div><dt>Thời gian dự kiến</dt><dd><Pending fact={w.transitTime} fallback="Báo theo từng lô hàng" /></dd></div>
      <div><dt>Hỏi nhanh</dt><dd><a class="text-link" href={telHref(provider.hotline)} data-track="call_click" data-track-location={`kho_${w.id}`} data-track-route={w.id}>{prettyPhone(provider.hotline)}</a> (Hotline / Zalo)</dd></div>
    </dl>
  </div>
</section>

<section class="section section-alt" aria-labelledby="wh-fit">
  <div class="container split">
    <div>
      <h2 id="wh-fit">Kho {w.city} phù hợp với hàng gì?</h2>
      <ul class="check-list">{w.goodsFit.map((g) => <li>{g}</li>)}</ul>
    </div>
    <div>
      <h2>Gửi hàng về kho {w.city}</h2>
      <ol class="wh-steps">
        <li>Đăng ký mã khách hàng trên viporder.com.vn.</li>
        <li>Nhận địa chỉ kho {w.city} và mẫu ghi người nhận qua hotline / Zalo.</li>
        <li>Báo nhà cung cấp gửi hàng về kho, ghi đúng mã khách hàng trên kiện.</li>
        <li>Theo dõi hàng bằng mã vận đơn / mã bao và nhận hàng tại Việt Nam.</li>
      </ol>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="wh-faq">
  <div class="container split">
    <div>
      <h2 id="wh-faq">Câu hỏi về kho {w.city}</h2>
      <p><a class="text-link" href={`/logistics/kho-${other.id}/`}>Xem thêm kho {other.city} →</a></p>
      <p><a class="text-link" href="/logistics/van-chuyen-trung-quoc-bac-ninh/">Nhận hàng tại Bắc Ninh →</a></p>
    </div>
    <FaqList items={faq} />
  </div>
</section>
<style>
  .wh-steps { margin: 0; padding-left: 20px; display: grid; gap: 10px; color: var(--text-2); }
  .split .btn { margin-top: 8px; }
</style>
