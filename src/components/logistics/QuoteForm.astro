---
/**
 * Form yêu cầu báo giá — CHƯA CÓ MÁY CHỦ NHẬN DỮ LIỆU (giống form liên hệ giai đoạn 1).
 *
 * An toàn dữ liệu:
 * - ô nhập chữ KHÔNG có `name` (chỉ nhóm radio có `name` để chọn-một bằng bàn phím), form KHÔNG có `action`, nút gửi `disabled` sẵn → tắt JS không gửi được gì;
 * - bật JS: kiểm tra hợp lệ, rồi GHÉP NỘI DUNG để khách TỰ gửi qua Zalo (sao chép) hoặc email (mailto).
 *   Website không lưu, không truyền dữ liệu khách tới máy chủ nào.
 * - Sự kiện đo lường chỉ chứa tuyến kho + dịch vụ, không chứa họ tên / SĐT.
 *
 * Khi có backend (OWNER ACTION): API nhận lead + honeypot + giới hạn tần suất + Cloudflare Turnstile —
 * đặc tả ở docs/seo/G06_ANALYTICS_LEAD_TRACKING.md.
 */
import { provider } from '../../data/vi/logistics';
import { getContent } from '../../data';
const { contact } = getContent('vi');
const routes = [
  ['quang-chau', 'Quảng Châu'],
  ['tham-quyen', 'Thâm Quyến'],
  ['khac', 'Nơi khác tại Trung Quốc'],
  ['chua-ro', 'Chưa rõ — cần tư vấn'],
];
const servicesOpts = ['Vận chuyển Trung – Việt', 'Nhập khẩu chính ngạch', 'Khai báo hải quan', 'Đặt hàng 1688 / Taobao / Pinduoduo'];
---
<form class="quote-form card" id="bao-gia" data-quote-form data-email={contact.email} data-zalo={provider.zaloUrl} novalidate>
  <h2 class="qf-title">Yêu cầu báo giá</h2>
  <p class="qf-note" role="note">
    Website chưa lưu yêu cầu trên máy chủ. Sau khi điền, bạn bấm <strong>Sao chép &amp; mở Zalo</strong> hoặc <strong>Gửi qua email</strong> để tự gửi nội dung cho đội ngũ {provider.name} (Zalo {provider.hotline} hoặc email {contact.email}).
  </p>
  <noscript><p class="qf-note">Trình duyệt đang tắt JavaScript — vui lòng gọi hoặc nhắn Zalo {provider.hotline}.</p></noscript>
  <div class="field-row">
    <div class="field">
      <label for="qf-name">Họ và tên <span aria-hidden="true">*</span></label>
      <input id="qf-name" type="text" autocomplete="name" required maxlength="80" />
    </div>
    <div class="field">
      <label for="qf-phone">Số điện thoại / Zalo <span aria-hidden="true">*</span></label>
      <input id="qf-phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9 +.]{9,15}" maxlength="15" />
    </div>
  </div>
  <fieldset class="field">
    <legend>Nhà cung cấp / nơi gửi hàng tại Trung Quốc</legend>
    <div class="radio-row">
      {routes.map(([v, l], i) => (
        <label class="radio"><input type="radio" name="qf-route" data-group="route" value={v} checked={i === 3} /> {l}</label>
      ))}
    </div>
  </fieldset>
  <div class="field-row">
    <div class="field">
      <label for="qf-dest">Nơi nhận hàng tại Việt Nam</label>
      <input id="qf-dest" type="text" placeholder="Ví dụ: Từ Sơn, Bắc Ninh" maxlength="80" />
    </div>
    <div class="field">
      <label for="qf-service">Dịch vụ cần</label>
      <select id="qf-service">
        {servicesOpts.map((s) => <option>{s}</option>)}
      </select>
    </div>
  </div>
  <div class="field">
    <label for="qf-goods">Loại hàng <span aria-hidden="true">*</span></label>
    <input id="qf-goods" type="text" required placeholder="Ví dụ: phụ kiện nội thất, linh kiện điện tử…" maxlength="120" />
  </div>
  <div class="field-row">
    <div class="field">
      <label for="qf-kg">Cân nặng ước tính (kg)</label>
      <input id="qf-kg" type="number" min="0" step="0.1" inputmode="decimal" />
    </div>
    <div class="field">
      <label for="qf-m3">Số khối ước tính (m³)</label>
      <input id="qf-m3" type="number" min="0" step="0.01" inputmode="decimal" />
    </div>
  </div>
  <div class="field">
    <label for="qf-msg">Ghi chú</label>
    <textarea id="qf-msg" rows="3" maxlength="600" placeholder="Tần suất nhập hàng, cần xuất hóa đơn, cần đóng gỗ…"></textarea>
  </div>
  <button class="btn btn-primary" type="submit" disabled data-submit>Tạo yêu cầu báo giá</button>
  <p class="form-status" data-status role="status" aria-live="polite"></p>
  <div class="qf-result" data-result hidden>
    <label for="qf-summary">Nội dung yêu cầu</label>
    <textarea id="qf-summary" rows="9" readonly data-summary></textarea>
    <div class="qf-actions">
      <button class="btn btn-primary" type="button" data-copy-zalo>Sao chép &amp; mở Zalo</button>
      <a class="btn btn-ghost" data-mailto href={`mailto:${contact.email}`}>Gửi qua email</a>
    </div>
  </div>
</form>

<style>
  .quote-form { display: grid; gap: 16px; scroll-margin-top: calc(var(--header-h) + 72px); }
  .qf-title { font-size: 26px; margin: 0; }
  .qf-note { margin: 0; padding: 12px 16px; border-radius: var(--radius-sm); background: rgba(208, 7, 26, .05); border: 1px solid rgba(208, 7, 26, .25); font-size: 14px; color: var(--text-2); }
  .field { display: grid; gap: 6px; min-width: 0; }
  fieldset.field { border: 0; padding: 0; margin: 0; }
  legend { font-size: 14px; font-weight: 600; margin-bottom: 6px; padding: 0; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .field-row { grid-template-columns: 1fr; } }
  label { font-size: 14px; font-weight: 600; }
  input, textarea, select { width: 100%; padding: 12px 14px; border-radius: var(--radius-sm); border: 1px solid var(--line-strong); background: var(--bg); color: var(--text); }
  input:focus-visible, textarea:focus-visible, select:focus-visible { border-color: var(--brand); }
  input[aria-invalid='true'] { border-color: var(--brand); }
  .radio-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .radio { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid var(--line-strong); border-radius: 999px; font-weight: 500; cursor: pointer; }
  .radio input { width: auto; accent-color: var(--brand); }
  .radio:has(input:checked) { border-color: var(--brand); background: rgba(208, 7, 26, .06); }
  button[disabled] { opacity: .55; cursor: not-allowed; transform: none; }
  .form-status { margin: 0; font-size: 14px; color: var(--brand-ink); min-height: 1.4em; }
  .qf-result { display: grid; gap: 10px; }
  .qf-result[hidden] { display: none; }
  .qf-actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-quote-form]');
  if (form) {
    const $ = <T extends Element>(s: string) => form.querySelector<T>(s);
    const submit = $<HTMLButtonElement>('[data-submit]');
    const status = $<HTMLElement>('[data-status]');
    const result = $<HTMLElement>('[data-result]');
    const summary = $<HTMLTextAreaElement>('[data-summary]');
    const mailto = $<HTMLAnchorElement>('[data-mailto]');
    const copyZalo = $<HTMLButtonElement>('[data-copy-zalo]');
    const track = (event: string, data: Record<string, unknown> = {}) =>
      document.dispatchEvent(new CustomEvent('vipg:track', { detail: { event, data } }));
    const val = (id: string) => ($<HTMLInputElement>(`#${id}`)?.value ?? '').trim();
    const route = () => form.querySelector<HTMLInputElement>('input[data-group="route"]:checked');
    form.querySelectorAll<HTMLInputElement>('input[data-group="route"]').forEach((r) =>
      r.addEventListener('change', () => track('route_select', { route: r.value })));
    if (submit) submit.disabled = false;
    let started = false;
    form.addEventListener('input', () => { if (!started) { started = true; track('quote_form_start'); } });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const required = ['qf-name', 'qf-phone', 'qf-goods'];
      let firstBad: HTMLInputElement | null = null;
      for (const id of required) {
        const el = $<HTMLInputElement>(`#${id}`)!;
        const ok = el.value.trim() !== '' && el.checkValidity();
        el.setAttribute('aria-invalid', String(!ok));
        if (!ok && !firstBad) firstBad = el;
      }
      if (firstBad) {
        if (status) status.textContent = 'Vui lòng điền họ tên, số điện thoại hợp lệ và loại hàng.';
        firstBad.focus();
        return;
      }
      const r = route();
      const routeLabel = r?.parentElement?.textContent?.trim() ?? '';
      const lines = [
        'YÊU CẦU BÁO GIÁ VẬN CHUYỂN (từ vipgroup.com.vn)',
        `Họ tên: ${val('qf-name')}`,
        `SĐT/Zalo: ${val('qf-phone')}`,
        `Nơi gửi tại Trung Quốc: ${routeLabel}`,
        `Nơi nhận tại Việt Nam: ${val('qf-dest') || '—'}`,
        `Dịch vụ: ${($<HTMLSelectElement>('#qf-service')?.value ?? '')}`,
        `Loại hàng: ${val('qf-goods')}`,
        `Cân nặng ước tính: ${val('qf-kg') ? val('qf-kg') + ' kg' : '—'}`,
        `Số khối ước tính: ${val('qf-m3') ? val('qf-m3') + ' m³' : '—'}`,
        `Ghi chú: ${val('qf-msg') || '—'}`,
      ];
      const text = lines.join('\n');
      if (summary) summary.value = text;
      if (mailto) mailto.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Yêu cầu báo giá vận chuyển Trung Quốc – Việt Nam')}&body=${encodeURIComponent(text)}`;
      if (result) result.hidden = false;
      if (status) status.textContent = 'Đã tạo nội dung. Dữ liệu CHƯA được gửi — bấm một trong hai nút bên dưới để gửi.';
      track('quote_generate', { route: r?.value ?? '', service: $<HTMLSelectElement>('#qf-service')?.value ?? '' });
      summary?.focus();
    });

    copyZalo?.addEventListener('click', async () => {
      const text = summary?.value ?? '';
      try { await navigator.clipboard.writeText(text); if (status) status.textContent = 'Đã sao chép. Dán nội dung vào khung chat Zalo vừa mở.'; }
      catch { summary?.select(); if (status) status.textContent = 'Không sao chép tự động được — hãy chọn và sao chép nội dung, rồi dán vào Zalo.'; }
      track('quote_send_zalo', { route: route()?.value ?? '' });
      window.open(form.dataset.zalo, '_blank', 'noopener');
    });
    mailto?.addEventListener('click', () => track('quote_send_email', { route: route()?.value ?? '' }));
  }
</script>
