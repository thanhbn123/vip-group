---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, htmlLang, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  noindex?: boolean;
}

const { title, description, locale = defaultLocale, noindex } = Astro.props;
const ui = t(locale);
---
<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06101d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <Seo title={title} description={description} locale={locale} noindex={noindex} />
  </head>
  <body>
    <!-- Đánh dấu có JS: menu mobile chỉ thu gọn khi JS chạy; tắt JS thì menu hiện sẵn.
         Đặt đầu <body> (SAU thẻ CSP trong <head>) để trình duyệt kiểm hash của script này. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
